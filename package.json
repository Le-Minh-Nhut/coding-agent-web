{
  "name": "coding-agent-web",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first self-hosted workspace for driving OMP coding agents on your own Ubuntu machine",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "dev": "pnpm --filter @caw/server dev",
    "start": "pnpm --filter @caw/server start",
    "compat": "node scripts/compat-check.mjs",
    "guest:build": "node scripts/build-guest.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.12",
    "esbuild": "0.25.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  }
}
